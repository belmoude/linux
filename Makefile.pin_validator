# Makefile for strict pin validator
# 用于编译pin校验模块

obj-m += strict_pin_validator.o pin_validator_example.o

# 编译选项
ccflags-y += -DCONFIG_DEBUG_VM_STRICT_PIN_CHECK

# 如果需要调试信息
ccflags-$(CONFIG_DEBUG_VM) += -DDEBUG

# 内核模块信息
MODULE_LICENSE := GPL
MODULE_AUTHOR := Your Name
MODULE_DESCRIPTION := Strict Pin User Page Validator
MODULE_VERSION := 1.0

# 编译规则
all:
	make -C /lib/modules/$(shell uname -r)/build M=$(PWD) modules

clean:
	make -C /lib/modules/$(shell uname -r)/build M=$(PWD) clean

install:
	make -C /lib/modules/$(shell uname -r)/build M=$(PWD) modules_install

# 测试规则
test: all
	sudo insmod strict_pin_validator.ko
	sudo insmod pin_validator_example.ko
	dmesg | tail -20
	sudo rmmod pin_validator_example
	sudo rmmod strict_pin_validator

.PHONY: all clean install test